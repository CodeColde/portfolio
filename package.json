{
  "name": "nextjs-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sanity:deploy": "dotenv -e .env sanity deploy",
    "sanity:start": "dotenv -e .env sanity start",
    "biome": "biome check --write --changed --no-errors-on-unmatched",
    "biome-ci": "biome ci --diagnostic-level=error --reporter=github --changed --no-errors-on-unmatched"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.6",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.11.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "framer-motion": "^12.34.3",
    "gsap": "^3.14.2",
    "lefthook": "^2.1.1",
    "next": "16.1.6",
    "next-sanity": "12.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-slick": "^0.31.0",
    "sanity": "^5.11.0",
    "slick-carousel": "^1.8.1",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.3",
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-slick": "^0.23.13",
    "eslint": "^10.0.1",
    "eslint-config-next": "16.1.6",
    "typescript": "^5.9.3"
  }
}
