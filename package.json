{
  "name": "nextjs-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sanity:deploy": "dotenv -e .env sanity deploy",
    "sanity:start": "dotenv -e .env sanity start",
    "biome": "biome check --write --changed --no-errors-on-unmatched",
    "biome-ci": "biome ci --diagnostic-level=error --reporter=github --changed --no-errors-on-unmatched"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.6",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "lefthook": "^2.1.14",
    "lenis": "^1.3.26",
    "motion": "^13.4.1",
    "next": "16.3.6",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
